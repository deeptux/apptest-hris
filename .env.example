# Copy to .env for local tooling only; .env is gitignored.
# On Render, set equivalent variables in each service dashboard — never commit secrets.

# --- API (Web Service on Render) ---
# Comma-separated browser origins allowed to call the API (your Blazor static site URL(s)).
# CORS_ORIGINS=https://your-client.onrender.com

# Gemini API key (overrides empty Ai:Gemini:ApiKey in appsettings). Use User Secrets when developing locally.
# Ai__Gemini__ApiKey=

# --- Blazor WASM static site ---
# The published client reads wwwroot/appsettings.Production.json for ApiBaseUrl.
# Set the real API HTTPS URL at publish time (see DEPLOYMENT.md) or edit that file before build.
