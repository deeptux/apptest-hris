{
  "Branding": {
    "OrganizationName": "Demo Organization",
    "ProductName": "HRIS Demo",
    "Tagline": "Phase 1 — Recruitment, Selection & Placement"
  },
  "Cors": {
    "Origins": [
      "https://localhost:7117",
      "http://localhost:5027"
    ]
  },
  "Ai": {
    "Enabled": true,
    "Provider": "Gemini",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "gemma2:2b"
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-2.5-flash-lite"
    },
    "JobDescription": {
      "MaxOutputTokens": 1024,
      "RequestTimeoutSeconds": 30,
      "Temperature": 0.75
    },
    "Quota": {
      "GlobalRpm": 10,
      "PerIpRpm": 4,
      "DailyHardCap": 1500,
      "DailySoftWarning": 1200
    },
    "Cache": {
      "Enabled": true,
      "TtlHours": 24
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
