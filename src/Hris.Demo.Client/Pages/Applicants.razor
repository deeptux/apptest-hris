@page "/applicants"
@inject RspDemoApiService Api

<PageTitle>Applicants</PageTitle>

<h1 class="mb-3">Applicants</h1>
<p class="text-muted small">Action: set screening outcome (Qualified / Pending / Rejected).</p>

<div class="d-flex align-items-center gap-2 mb-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}
else if (_items is null)
{
    <p>Loading…</p>
}
else
{
    <div class="table-responsive rsp-card">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Applied for</th>
                    <th>Person profile</th>
                    <th>Outcome</th>
                    <th>Screen score</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _items)
                {
                    <tr>
                        <td>@a.FullName</td>
                        <td>@a.AppliedFor</td>
                        <td>@ResolveProfile(a.PersonProfileId)</td>
                        <td>@a.EligibilityFlag</td>
                        <td>@a.ScreenScore</td>
                        <td class="text-end">
                            <select class="form-select form-select-sm d-inline-block me-2" style="width: 8rem;" @bind="_pendingOutcome[a.Id]">
                                <option value="Qualified">Qualified</option>
                                <option value="Pending">Pending</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetOutcomeAsync(a.Id)">Set</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter(Name = "SimulatedRole")]
    public string SimulatedRole { get; set; } = "HR";

    private IReadOnlyList<ApplicantDto>? _items;
    private Dictionary<Guid, string> _profiles = [];
    private Dictionary<Guid, string> _pendingOutcome = [];
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var itemsTask = Api.GetApplicantsAsync();
            var profilesTask = Api.GetPersonProfilesAsync();
            await Task.WhenAll(itemsTask, profilesTask);
            _items = await itemsTask;
            var profiles = await profilesTask;
            _profiles = (profiles ?? []).ToDictionary(x => x.Id, x => x.FullName);

            _pendingOutcome.Clear();
            foreach (var item in _items ?? [])
            {
                _pendingOutcome[item.Id] = item.EligibilityFlag;
            }

            _error = _items is null ? "Could not load data. Start the API project." : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SetOutcomeAsync(Guid id)
    {
        var selected = _pendingOutcome.TryGetValue(id, out var value) ? value : "Pending";
        await Api.SetApplicantOutcomeAsync(id, SimulatedRole, selected);
        await LoadAsync();
    }

    private string ResolveProfile(Guid? id)
    {
        if (id is null)
        {
            return "—";
        }

        return _profiles.TryGetValue(id.Value, out var value) ? value : "Unknown";
    }
}
