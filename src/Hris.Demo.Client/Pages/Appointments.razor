@page "/appointments"
@inject RspDemoApiService Api

<PageTitle>Appointment packages</PageTitle>

<h1 class="mb-3">Appointment packages</h1>
<p class="text-muted small">Stub records for appointment workflow narrative.</p>

<div class="d-flex align-items-center gap-2 mb-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}
else if (_items is null)
{
    <p>Loading…</p>
}
else
{
    <div class="table-responsive rsp-card">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Applicant</th>
                    <th>Applicant ID</th>
                    <th>Position</th>
                    <th>Position item</th>
                    <th>Package status</th>
                    <th>Effectivity</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in _items)
                {
                    <tr>
                        <td>@x.ApplicantName</td>
                        <td><code>@x.SelectedApplicantId.ToString()[..8]</code></td>
                        <td>@x.PositionTitle</td>
                        <td>@ResolvePositionItem(x.PositionItemId)</td>
                        <td><span class="badge text-bg-light border">@x.PackageStatus</span></td>
                        <td>@(x.Effectivity?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-success" @onclick="() => MarkAsAppointedAsync(x.Id)" disabled="@(x.PackageStatus == "Appointed")">
                                Mark as appointed
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter(Name = "SimulatedRole")]
    public string SimulatedRole { get; set; } = "HR";

    private IReadOnlyList<AppointmentPackageDto>? _items;
    private Dictionary<Guid, string> _positionItems = [];
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var itemsTask = Api.GetAppointmentsAsync();
            var positionsTask = Api.GetPositionItemsAsync();
            await Task.WhenAll(itemsTask, positionsTask);
            _items = await itemsTask;
            var positions = await positionsTask;
            _positionItems = (positions ?? []).ToDictionary(x => x.Id, x => x.ItemNumber);
            _error = _items is null ? "Could not load data. Start the API project." : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task MarkAsAppointedAsync(Guid id)
    {
        await Api.MarkAppointmentAsAppointedAsync(id, SimulatedRole, DateOnly.FromDateTime(DateTime.Today));
        await LoadAsync();
    }

    private string ResolvePositionItem(Guid id) =>
        _positionItems.TryGetValue(id, out var value) ? value : "Unknown";
}
