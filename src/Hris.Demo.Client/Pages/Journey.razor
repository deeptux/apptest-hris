@page "/journey"
@inject RspDemoApiService Api

<PageTitle>RSP journey</PageTitle>

<h1 class="mb-3">Recruitment, selection & placement journey</h1>
<p class="text-muted">Seven ordered steps (mock data from API).</p>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}
else if (_steps is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var step in _steps)
        {
            <div class="rsp-card d-flex gap-3 p-3 align-items-start">
                <span class="journey-step-index flex-shrink-0">@step.Order</span>
                <div>
                    <h2 class="h5 mb-1">@step.Title</h2>
                    <p class="small text-muted mb-0">@step.Summary</p>
                    <code class="small text-muted">@step.Key</code>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<RspJourneyStepDto>? _steps;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _steps = await Api.GetJourneyStepsAsync();
            _error = _steps is null ? "Could not load journey steps. Is the API running (see launch profile https://localhost:7209)?" : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
