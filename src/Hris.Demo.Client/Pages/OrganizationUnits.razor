@page "/foundation/organization-units"
@inject RspDemoApiService Api

<PageTitle>Organization units</PageTitle>

<h1 class="mb-3">Organization units</h1>
<p class="text-muted small">Demo foundation: create, edit, and deactivate units used by RSP records.</p>

<div class="d-flex align-items-center gap-3 mb-3">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="ouIncludeInactive" @bind="_includeInactive" @bind:after="LoadAsync" />
        <label class="form-check-label" for="ouIncludeInactive">Include inactive</label>
    </div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="table-responsive rsp-card">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items is not null)
                    {
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td><code>@item.Code</code></td>
                                <td>@item.Name</td>
                                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => BeginEdit(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateAsync(item.Id)" disabled="@(!item.IsActive)">Deactivate</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="rsp-card p-3">
            <h2 class="h5 mb-3">@(_editingId is null ? "Create unit" : "Edit unit")</h2>
            <div class="mb-2">
                <label class="form-label">Code</label>
                <input class="form-control" @bind="_form.Code" />
            </div>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="_form.Name" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetForm">Clear</button>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<OrganizationUnitDto>? _items;
    private string? _error;
    private bool _includeInactive;
    private Guid? _editingId;
    private OrganizationUnitUpsertDto _form = new(string.Empty, string.Empty);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _items = await Api.GetOrganizationUnitsAsync(_includeInactive);
            _error = _items is null ? "Could not load organization units." : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void BeginEdit(OrganizationUnitDto item)
    {
        _editingId = item.Id;
        _form = new OrganizationUnitUpsertDto(item.Code, item.Name);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = "Code and Name are required.";
            return;
        }

        if (_editingId is null)
        {
            await Api.CreateOrganizationUnitAsync(_form);
        }
        else
        {
            await Api.UpdateOrganizationUnitAsync(_editingId.Value, _form);
        }

        ResetForm();
        await LoadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        await Api.DeactivateOrganizationUnitAsync(id);
        await LoadAsync();
    }

    private void ResetForm()
    {
        _editingId = null;
        _form = new OrganizationUnitUpsertDto(string.Empty, string.Empty);
    }
}
