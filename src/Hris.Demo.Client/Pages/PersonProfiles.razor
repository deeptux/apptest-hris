@page "/foundation/person-profiles"
@inject RspDemoApiService Api

<PageTitle>Person profiles</PageTitle>

<h1 class="mb-3">Person profiles</h1>
<p class="text-muted small">Candidate/appointee profile registry for demo linkage and appointment conversion.</p>

<div class="d-flex align-items-center gap-3 mb-3">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="ppIncludeInactive" @bind="_includeInactive" @bind:after="LoadAsync" />
        <label class="form-check-label" for="ppIncludeInactive">Include inactive</label>
    </div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="table-responsive rsp-card">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Employee</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items is not null)
                    {
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td>@item.FullName</td>
                                <td>@(item.EmailAddress ?? "—")</td>
                                <td>@(item.IsEmployee ? item.EmployeeNumber ?? "Yes" : "No")</td>
                                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => BeginEdit(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateAsync(item.Id)" disabled="@(!item.IsActive)">Deactivate</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="rsp-card p-3">
            <h2 class="h5 mb-3">@(_editingId is null ? "Create profile" : "Edit profile")</h2>
            <div class="mb-2"><label class="form-label">Full name</label><input class="form-control" @bind="_form.FullName" /></div>
            <div class="mb-3"><label class="form-label">Email address</label><input class="form-control" @bind="_form.EmailAddress" /></div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetForm">Clear</button>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<PersonProfileDto>? _items;
    private string? _error;
    private bool _includeInactive;
    private Guid? _editingId;
    private PersonProfileUpsertDto _form = new(string.Empty, null);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _items = await Api.GetPersonProfilesAsync(_includeInactive);
            _error = _items is null ? "Could not load person profiles." : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void BeginEdit(PersonProfileDto item)
    {
        _editingId = item.Id;
        _form = new PersonProfileUpsertDto(item.FullName, item.EmailAddress);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.FullName))
        {
            _error = "Full name is required.";
            return;
        }

        if (_editingId is null)
        {
            await Api.CreatePersonProfileAsync(_form);
        }
        else
        {
            await Api.UpdatePersonProfileAsync(_editingId.Value, _form);
        }

        ResetForm();
        await LoadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        await Api.DeactivatePersonProfileAsync(id);
        await LoadAsync();
    }

    private void ResetForm()
    {
        _editingId = null;
        _form = new PersonProfileUpsertDto(string.Empty, null);
    }
}
