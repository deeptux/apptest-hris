@page "/vacancies"
@inject RspDemoApiService Api

<PageTitle>Vacancies</PageTitle>

<h1 class="mb-3">Vacancies</h1>
<p class="text-muted small">Action: publish/unpublish toggle.</p>

<div class="d-flex align-items-center gap-2 mb-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}
else if (_items is null)
{
    <p>Loading…</p>
}
else
{
    <div class="table-responsive rsp-card">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>SG</th>
                    <th>Position item</th>
                    <th>Open</th>
                    <th>Close</th>
                    <th>Publication</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in _items)
                {
                    <tr>
                        <td>@v.Title</td>
                        <td>@v.SalaryGrade</td>
                        <td>@ResolvePositionItem(v.PositionItemId)</td>
                        <td>@v.OpenFrom.ToString("yyyy-MM-dd")</td>
                        <td>@v.OpenUntil.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge text-bg-light border">@v.PublicationStatus</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAsync(v.Id)">Toggle</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter(Name = "SimulatedRole")]
    public string SimulatedRole { get; set; } = "HR";

    private IReadOnlyList<VacancyDto>? _items;
    private Dictionary<Guid, string> _positionItems = [];
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var itemsTask = Api.GetVacanciesAsync();
            var posTask = Api.GetPositionItemsAsync();
            await Task.WhenAll(itemsTask, posTask);
            _items = await itemsTask;
            var positions = await posTask;
            _positionItems = (positions ?? []).ToDictionary(x => x.Id, x => x.ItemNumber);
            _error = _items is null ? "Could not load data. Start the API project." : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleAsync(Guid id)
    {
        await Api.ToggleVacancyPublishAsync(id, SimulatedRole);
        await LoadAsync();
    }

    private string ResolvePositionItem(Guid id) =>
        _positionItems.TryGetValue(id, out var value) ? value : "Unknown";
}
